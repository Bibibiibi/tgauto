# Get these two values from https://my.telegram.org -> API development tools.
TG_API_ID=123456
TG_API_HASH=replace_with_your_api_hash

# Needed only on the first run, when tg_checkin.session does not exist yet.
# Use international format, for example +8613812345678.
TG_PHONE=+8613812345678

# Optional paths.
TG_SESSION=./tg_checkin.session
TG_CONFIG=./bots.json

# Optional Telegram-only Mihomo proxy (the Web console writes these settings).
TG_PROXY_ENABLED=false
TG_PROXY_HOST=127.0.0.1
TG_PROXY_PORT=7890

# Optional secret for the internal Mihomo controller API.
MIHOMO_API_SECRET=

# Health-check imported nodes against Telegram instead of a generic endpoint.
MIHOMO_HEALTHCHECK_URL=https://telegram.org
MIHOMO_HEALTHCHECK_EXPECTED_STATUS=200-399

# Optional browser fingerprint used for NodeSeek check-in requests.
NODESEEK_IMPERSONATE=chrome136

# Optional management-console authentication (not a NodeSeek login).
# Set a strong password and use HTTPS when accessed outside a trusted network.
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=
# Set to 127.0.0.1 when using a local reverse proxy or SSH tunnel.
WEB_BIND_ADDRESS=0.0.0.0
